# =============================================================================
# DS102/DS112 步進馬達控制器
# =============================================================================

# --- Python 虛擬環境 / 快取 ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.mypy_cache/

# --- 執行期產出（本機資料，不進版控）---
logs/
recordings/
data/
ds102_log_*.log
*.log

# --- 報告產出（md-document skill，本機檔案，不進版控）---
reports/

# --- 打包產出（PyInstaller / auto-py-to-exe）---
output/
build/
dist/
*.spec

# --- 廠商驅動安裝檔（體積大、非本專案原始碼）---
DS102-CDMv21228/
DS102_USB_Driver_V2.08.28/

# --- 廠商手冊（體積大）---
# ds102 (2).pdf = DS102/DS112 Operation Manual Ver 2.00，指令表的權威來源。
# 不進版控，但 CLAUDE.md 有引用，換機器時記得另外取得。
*.pdf

# --- 作業系統 / 編輯器 ---
Thumbs.db
desktop.ini
.DS_Store
*.swp

# --- MS Office 暫存鎖定檔（開啟 .pptx/.docx/.xlsx 時產生，不是文件本體）---
~$*

# .vscode 只保留團隊共用設定，個人覆寫不進版控
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
