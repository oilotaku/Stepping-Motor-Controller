{
  // ===========================================================================
  // Python 直譯器 / 虛擬環境
  // ===========================================================================
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,

  // 中文輸出不再變亂碼（Windows 終端機預設 cp950）
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },

  // ===========================================================================
  // 測試（pytest）：verify_scan_tab.py / verify_meter_panel.py
  // ===========================================================================
  // VS Code 的測試執行不一定會套用 terminal.integrated.env.windows（那只對
  // 「整合終端機」生效，Test Explorer 是另一條執行路徑），所以中文輸出的
  // PYTHONUTF8/PYTHONIOENCODING 改由 conftest.py 開頭的 os.environ.setdefault()
  // 補上，不依賴這裡的環境變數設定也能正確顯示。
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  // 明確指到專案 venv 的 pytest.exe，而非依賴當時選取的直譯器——
  // CLAUDE.md 反覆強調全域 Python 沒裝 pyserial/PyVISA 等相依套件，
  // 用錯直譯器執行測試會在 import main_ai 階段就失敗。
  "python.testing.pytestPath": "${workspaceFolder}/venv/Scripts/pytest.exe",
  "python.testing.pytestArgs": [
    "."
  ],
  "python.testing.cwd": "${workspaceFolder}",
  // 2026-08-19 排查「Testing 面板只顯示 123 項，明明有 187 項」時發現：
  // ms-python.python 2026.4.0 的 useEnvExtension() 判斷式是
  // `!!getExtension("ms-python.vscode-python-envs") && config.get("python.useEnvironmentsExtension", false)`
  // ——vscode.extensions.getExtension() 只要擴充套件「有安裝」就回傳
  // truthy，跟它是否被停用（Disable）無關，所以直接停用
  // ms-python.vscode-python-envs 這個擴充套件沒有用。真正的開關是這個
  // setting，預設值是 false，但這台機器不知為何被開成 true（不在原本
  // 這份檔案或使用者全域 settings.json 裡，懷疑是 Microsoft 的實驗
  // (A/B) 機制注入的預設值）。開啟後會啟用新的「test-by-project」探索
  // 路徑，這條路徑在磁碟機代號大小寫不一致時（`d:\...` vs 解析出來的
  // `D:\...`，log 會看到 "Working directory resolves to different
  // path" 警告）會把部分測試項目配對不到 project、從 Testing 面板的樹
  // 狀畫面裡默默丟掉——背景探索子行程本身仍然正確收集到完整項目數
  // （log 的 collected 數字是對的），只有面板顯示不完整。明確設為
  // false 蓋掉任何實驗預設值，退回沒有這條配對邏輯的舊版探索路徑。
  "python.useEnvironmentsExtension": false,

  // ===========================================================================
  // Pylance 分析：只分析自己的程式碼，避開 venv 與驅動程式資料夾
  // ===========================================================================
  "python.analysis.typeCheckingMode": "basic",

  // ---------------------------------------------------------------------------
  // 降噪：pyserial / PyVISA / tkinter 的型別描述檔與實際行為有落差，
  // 會冒出一堆「紅色波浪」但程式跑起來完全正常（實測驗證過）。
  // 把這幾類降成 information（淡色小點，滑鼠移過去仍看得到說明），
  // 保留 reportCallIssue / reportUndefinedVariable 等真正抓得到 bug 的檢查。
  // 效果：全專案 54 個紅色錯誤 → 3 個（其中 2 個是 main.py 的真實寫法錯誤）。
  // ---------------------------------------------------------------------------
  "python.analysis.diagnosticSeverityOverrides": {
    // int(序列埠回傳值) — 檢查器看不出你已經做過 None 防呆
    "reportArgumentType": "information",
    // ser.isOpen（描述檔漏掉的舊寫法）、PyVISA Resource.query/.write
    "reportAttributeAccessIssue": "information",
    // tkinter 元件宣告為 Optional，但 UI 建好後不可能是 None
    "reportOptionalMemberAccess": "information",
    "reportOptionalSubscript": "information",
    "reportOptionalIterable": "information",
    "reportOptionalCall": "information",
    "reportOptionalOperand": "information",
    "reportIndexIssue": "information",

    // --- 以下保持紅色，這些是真的會咬人的 ---
    "reportCallIssue": "error",          // 參數個數/型別錯、漏帶參數
    "reportUndefinedVariable": "error",  // 打錯變數名、拼錯字
    "reportMissingImports": "error",     // 套件沒裝或直譯器選錯
    "reportSelfClsParameterName": "error"
  },

  "python.analysis.autoImportCompletions": true,
  "python.analysis.indexing": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": false,
  "python.analysis.exclude": [
    // 前兩項是 Pylance 的預設值，自訂 exclude 會覆寫掉預設，要自己補回來
    "**/node_modules",
    "**/.*",
    "**/venv/**",
    "**/__pycache__/**",
    "DS102-CDMv21228/**",
    "DS102_USB_Driver_V2.08.28/**"
  ],

  // ===========================================================================
  // 搜尋 / 檔案監看排除（大幅加快 Ctrl+Shift+F 與開檔速度）
  // ===========================================================================
  "search.exclude": {
    "**/venv": true,
    "**/__pycache__": true,
    "DS102-CDMv21228": true,
    "DS102_USB_Driver_V2.08.28": true,
    "logs": true,
    "recordings": true,
    "data": true,
    "**/*.log": true
  },
  "files.watcherExclude": {
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/logs/**": true,
    "**/recordings/**": true,
    "**/data/**": true,
    "DS102-CDMv21228/**": true,
    "DS102_USB_Driver_V2.08.28/**": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },

  // 把散在根目錄的 log 檔收進 Readme_Python.txt 底下，檔案總管清爽一點
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "Readme_Python.txt": "ds102_log_*.log, DRIVER_ISSUE_REPORT.md",
    "requirements.txt": "requirements-*.txt"
  },

  // ===========================================================================
  // 編輯器行為
  // ===========================================================================
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyScroll.enabled": true,

  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "editor.wordBasedSuggestions": "off",
    // Ruff 裝好後可用 Shift+Alt+F 手動格式化。
    // 本專案沒有版本控制，先「不」開自動格式化，避免整份 main_ai.py 被大改。
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },

  "[json][jsonc]": {
    "editor.tabSize": 2
  },

  // log 檔唯讀開啟，避免手滑改到紀錄
  "files.readonlyInclude": {
    "logs/**": true,
    "**/ds102_log_*.log": true
  },
  "claudeCode.useTerminal": false
}
